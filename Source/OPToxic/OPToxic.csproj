<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputPath>..\..\1.7\Assemblies</OutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>None</DebugType>
    <LangVersion>latest</LangVersion>
    <FileVersion>1.7.0</FileVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyVersion>1.7</AssemblyVersion>
    <Product>Apex: Rimworld Legends (Continued)</Product>
    <Copyright>© Oskar Potocki 2026 - T</Copyright>
    <Nullable>warnings</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref">
      <Version>1.7.4979-alpha</Version>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="KillRimWorld" BeforeTargets="Clean;Build">
    <Exec Command="tasklist /FI &quot;IMAGENAME eq RimWorld.exe&quot; | find /I &quot;RimWorld.exe&quot; &lt;;nul &amp;&amp; taskkill /F /IM RimWorld.exe" IgnoreExitCode="true" />
  </Target>
</Project>